{
  "name": "haryana-grow-room-simulator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:physics": "vitest run src/tests/regression_physics.test.ts src/tests/equipmentExperiments.test.ts",
    "test:e2e": "playwright test",
    "test:weather:live": "vitest run src/tests/weatherIntegration.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run test:physics"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.3",
    "recharts": "^2.15.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
